APP_NAME="Club 61 Padel & Wellness"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Batas tunggu server SMTP (detik). Dulu tanpa batas: SMTP lambat menahan proses s.d. ±60 detik.
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Akun billing@ — invoice lunas (booking online & membership) + voucher saldo. Server SMTP ikut MAIL_HOST/PORT di atas.
MAIL_BILLING_USERNAME=
MAIL_BILLING_PASSWORD=
MAIL_BILLING_FROM_ADDRESS=
MAIL_BILLING_FROM_NAME="${APP_NAME}"

# Balasan customer masuk ke kotak ini (info@).
MAIL_REPLY_TO_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
 
# Payment Gateway & Midtrans
PAYMENT_GATEWAY_DRIVER=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Opsional (laptop developer + ngrok): https://<subdomain>.ngrok-free.dev/api/v1/padel/webhook/midtrans
MIDTRANS_NOTIFICATION_URL=

# DOKU Checkout (Modul 27) — kunci dari Settings > Account > API Keys (akun sandbox terpisah dari production)
DOKU_ENABLED=false
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false
# Opsional, path harus sama dengan URL notifikasi di dashboard DOKU
DOKU_NOTIFICATION_URL=
# DOKU SNAP (Modul 27b) — QRIS & VA BCA dengan halaman bayar sendiri. Kunci berupa PATH file di server (di luar public/).
DOKU_SNAP_ENABLED=false
DOKU_SNAP_CLIENT_ID=
DOKU_SNAP_CLIENT_SECRET=
DOKU_SNAP_PRIVATE_KEY_PATH=
DOKU_SNAP_PRIVATE_KEY_PASSPHRASE=
DOKU_SNAP_DOKU_PUBLIC_KEY_PATH=
DOKU_SNAP_QRIS_MERCHANT_ID=
DOKU_SNAP_QRIS_TERMINAL_ID=
DOKU_SNAP_QRIS_POSTAL_CODE=
DOKU_SNAP_BCA_PARTNER_SERVICE_ID=
# Prefix sub-BIN merchant untuk VA BCA DGPC (contoh resmi DOKU: 0). Ganti hanya kalau DOKU memberi sub-BIN lain.
DOKU_SNAP_BCA_CUSTOMER_NO=0
# Diagnosa sementara: catat bentuk permintaan DOKU ke kita (tanpa token/tanda tangan/data customer) di storage/logs/doku-*.log
DOKU_SNAP_DEBUG_INBOUND=false
# true = notifikasi VA dengan X-SIGNATURE tidak cocok ditolak. Nyalakan setelah storage/logs/doku-*.log menulis "X-SIGNATURE cocok"
DOKU_SNAP_VERIFY_VA_SIGNATURE=false


# Mode Coming Soon halaman /login sampai grand opening (zona APP_TIMEZONE), mis. 2026-11-26 00:00.
# Kosong = mati (normal). Selama aktif: customer ditolak login & daftar ditutup; staf masuk lewat tombol "Login Staf".
COMING_SOON_UNTIL=

# Batas booking (config/booking_window.php) — berlaku untuk customer online, POS Walk-In & reschedule, termasuk super admin.
# BOOKING_OPEN_UNTIL: tanggal main TERAKHIR yang boleh dibooking (Y-m-d), mis. 2026-11-25. Kosong = tanpa batas.
# BOOKING_CLOSED_DATES: tanggal tutup sehari penuh, pisahkan koma, mis. 2026-11-26 (Jadwal Tetap minggu itu dilewati).
# BOOKING_CLOSED_REASON: keterangan di pesan, mis. Grand Opening. Setelah diubah: php artisan config:cache, cek php artisan booking:window
BOOKING_OPEN_UNTIL=
BOOKING_CLOSED_DATES=
BOOKING_CLOSED_REASON=

# Slip stasiun F&B (Kitchen) dari BROWSER PC kasir — docs/PRINT_AGENT.md. Aplikasi Android Club61 tidak terpengaruh.
# tablet = perilaku lama (dari browser tidak bisa) | agent = lewat Club61 Print Agent di PC kasir | mock = tes tanpa printer
STATION_PRINT_DRIVER=tablet
STATION_PRINT_AGENT_URL=http://127.0.0.1:9120
# Sama persis dengan "token" di agent.json (minimal 24 karakter acak).
STATION_PRINT_AGENT_TOKEN=
# Kertas 58mm di printer stasiun 80mm: geser slip ke kanan (titik printer, 0–192; Kitchen venue = 156). Ikut ke aplikasi Android.
STATION_PRINT_LEFT_MARGIN=0
